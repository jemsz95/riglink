{
  "name": "riglink",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --project-id nhrtxcdmnjvewvctfwao > src/lib/supabase/database.types.ts",
    "db:test": "supabase test db",
    "db:push": "supabase db push --project-ref nhrtxcdmnjvewvctfwao",
    "ui:add": "shadcn add && node scripts/normalize-ui.mjs",
    "ui:normalize": "node scripts/normalize-ui.mjs",
    "test:browser": "vitest run --project browser",
    "config:diff": "supabase config diff --project-ref nhrtxcdmnjvewvctfwao",
    "config:push": "supabase config push --project-ref nhrtxcdmnjvewvctfwao",
    "db:migrations": "supabase migration list --project-ref nhrtxcdmnjvewvctfwao",
    "deploy": "supabase db push --project-ref nhrtxcdmnjvewvctfwao && supabase config push --project-ref nhrtxcdmnjvewvctfwao"
  },
