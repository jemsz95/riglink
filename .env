# Production values, committed on purpose. `vite dev` and `vite build` both
# load this file; anything in a gitignored override wins:
#
#   .env.local              dev and builds (e.g. a local stack, `npm run db:start`)
#   .env.development.local  `vite dev` only -- builds keep production values
#
# Everything VITE_-prefixed is PUBLIC -- it ships inside the JS bundle. The
# publishable key is designed for that; RLS is the security boundary. Never put
# a secret_key/service_role key, SMTP credential or accounting OAuth secret in
# this file or any VITE_ variable: committed or not, it ends up in the bundle.
#
# The CSP in firebase.json names this Supabase origin. Change one, change the
# other -- `npm run build` refuses to build if they disagree.
VITE_SUPABASE_URL=https://nhrtxcdmnjvewvctfwao.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_DZ0-3_umRqbRlVO68bCUYA_-B_bcdWe
