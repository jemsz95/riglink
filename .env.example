# Copy to .env.local and fill in.
#
# During development this points at the remote project; `npm run db:start`
# (needs Docker) would give you a local stack instead.
#
# Everything VITE_-prefixed is PUBLIC -- it ships inside the JS bundle. The anon
# key is designed for this; RLS is the security boundary. Never put a
# service_role key, SMTP credential or accounting OAuth secret in here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer the modern sb_publishable_... key over the legacy anon JWT.
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
